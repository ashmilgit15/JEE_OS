# ── JEE OS environment configuration ───────────────────────────────────────
# Copy to .env.local and fill in. Optional keys degrade gracefully (the app
# logs a warning at startup and disables the corresponding feature).

# Supabase (required for auth + cross-device sync; omit for local-only mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hack Club AI proxy (optional — enables the AI tutor/coach; without it the
# app falls back to local smart responses)
HACKCLUB_API_KEY=
# Optional model override (defaults to google/gemini-3.5-flash)
HACKCLUB_MODEL=

# Tavily web search (optional — enables web/textbook search and AI mock-test
# generation; without it those features degrade)
TAVILY_API_KEY=

# Sentry error tracking (optional — enables server/client error reporting)
NEXT_PUBLIC_SENTRY_DSN=
